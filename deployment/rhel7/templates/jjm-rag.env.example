# Copy to /etc/jjm-rag/jjm-rag.env. This file intentionally has no secrets.
JJM_DATABASE_URL=

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=jjm_rag_semantic_v1
QDRANT_TIMEOUT=60
QDRANT_BATCH_SIZE=32

GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768
GEMINI_TIMEOUT_SECONDS=60

XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.6
XAI_TIMEOUT_SECONDS=20
XAI_MAX_RETRIES=2

RAG_MAX_EVIDENCE=10
RAG_MAX_OUTPUT_TOKENS=800
DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=120
